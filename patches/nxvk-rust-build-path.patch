diff --git a/switch/build/configure-mesa.sh b/switch/build/configure-mesa.sh
index bd24665..269342d 100755
--- a/switch/build/configure-mesa.sh
+++ b/switch/build/configure-mesa.sh
@@ -23,9 +23,19 @@ cp -r "$SRC/switch/docker/cross-include/." /opt/switch-cross-include/ 2>/dev/null || true
 RECONF=""
 [ -f "$BUILD/build.ninja" ] && RECONF="--wipe"

+# The upstream Rust cross file historically used /work. Generate a stable
+# copy with the wrapper resolved from the actual source directory. It must
+# live beside, not below, $BUILD: Meson's --wipe removes the build directory,
+# while Ninja may need the cross file again when regenerating build.ninja.
+RUST_CROSS_FILE="${BUILD}.rust.cross"
+awk -v rust_wrapper="$SRC/switch/rust/rustc-switch.sh" '
+  $0 ~ /^rust[[:space:]]*=/ { print "rust    = [" sq rust_wrapper sq "]"; next }
+  { print }
+' sq="'" "$SRC/switch/crossfiles/rust.cross" > "$RUST_CROSS_FILE"
+
 meson setup $RECONF "$BUILD" "$SRC" \
   --cross-file "$SRC/switch/crossfiles/switch.cross" \
-  --cross-file "$SRC/switch/crossfiles/rust.cross" \
+  --cross-file "$RUST_CROSS_FILE" \
   --native-file "$SRC/switch/crossfiles/native.txt" \
   --buildtype release \
   -Dmesa-clc=system \
