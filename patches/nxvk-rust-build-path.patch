diff --git a/switch/rust/build-std-sysroot.sh b/switch/rust/build-std-sysroot.sh
--- a/switch/rust/build-std-sysroot.sh
+++ b/switch/rust/build-std-sysroot.sh
@@ -8,8 +8,11 @@
 #       bash switch/rust/build-std-sysroot.sh
 set -e
 
-export RUST_TARGET_PATH=/work/switch/rust RUSTC_BOOTSTRAP=1
+# The source tree may be mounted at /work, a GitHub workspace, or another
+# path.  Resolve it from this script instead of assuming the old /work mount.
+NXVK_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
+export RUST_TARGET_PATH="$NXVK_ROOT/switch/rust" RUSTC_BOOTSTRAP=1
 export RUSTFLAGS='-Zunstable-options -L /opt/devkitpro/devkitA64/aarch64-none-elf/lib -L /opt/devkitpro/libnx/lib'
 TGT=aarch64-switch-horizon
-SYSROOT=/work/switch/rust/sysroot
+SYSROOT="$NXVK_ROOT/switch/rust/sysroot"
 RUSTC_SYSROOT="$(rustc --print sysroot)"
